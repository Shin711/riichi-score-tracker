NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Optional (recommended for production): used by server route handlers
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional: secures GET /api/cron/archive-leaderboard (Vercel Cron on the 1st of each month)
CRON_SECRET=YOUR_RANDOM_SECRET

# Optional: admin-only player delete on /players (comma-separated; set at least one)
ADMIN_USER_IDS=your-supabase-auth-user-uuid
# ADMIN_EMAILS=you@example.com
