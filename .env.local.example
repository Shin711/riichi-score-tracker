NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Optional (recommended for production): used by server route handlers
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional: secures GET /api/cron/archive-leaderboard (Vercel Cron on the 1st of each month)
CRON_SECRET=YOUR_RANDOM_SECRET

# Optional: admin-only player delete on /players (comma-separated; set at least one)
ADMIN_USER_IDS=your-supabase-auth-user-uuid
# ADMIN_EMAILS=you@example.com

# Optional: enables "Add from Mahjong Soul" on /import (paste a game ID or share
# link to import scores automatically). Without both values the card is hidden
# and imports stay manual.
#
# Use a dedicated account — the importer holds a real Mahjong Soul login session
# as this account, so anyone playing on it at the same time can get kicked.
#
# These are YOSTAR SESSION credentials, not a Mahjong Soul password. Since
# Mahjong Soul moved the English server onto unified Yostar accounts (March
# 2026), sign-in is email + emailed code, so the session has to be captured once
# from a browser:
#
#   1. Open DevTools -> Network and filter for `quick-login`.
#   2. Sign in at https://mahjongsoul.game.yo-star.com/ with the dedicated account.
#   3. Select the POST to `en-sdk-api.yostarplat.com/user/quick-login`.
#   4. Read its `Authorization` header (some browsers show it as the request
#      payload). It looks like:
#        {"Head": {"UID": "<uid>", "Token": "<token>", "DeviceID": "...", ...}, ...}
#   5. Copy `UID` -> MAJSOUL_UID and `Token` -> MAJSOUL_TOKEN.
#
# Use the UID here, not your in-game friend code. The token is bound to that
# login's device id and is long-lived, but if it is ever invalidated imports fail
# with an explicit "expired"/"rejected" message — recapture and redeploy.
MAJSOUL_UID=your-yostar-uid
MAJSOUL_TOKEN=your-yostar-session-token
# Client build the importer claims to be; bump if Mahjong Soul rejects lookups.
# MAJSOUL_CLIENT_VERSION=0.16.213
